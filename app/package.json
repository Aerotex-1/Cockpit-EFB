{
  "name": "cockpit-efb-app",
  "productName": "Cockpit EFB",
  "version": "1.5.2",
  "description": "Cockpit EFB – Windows-App zum Starten, Einstellen und Aktualisieren",
  "main": "boot.js",
  "author": "Cockpit EFB",
  "license": "MIT",
  "scripts": {
    "prepare-bundle": "node tools/prepare-bundle.js",
    "start": "node tools/prepare-bundle.js && electron .",
    "dist": "node tools/prepare-bundle.js && node tools/fetch-voices.js && electron-builder --win --publish never",
    "test": "node tools/test-voices.js && node tools/test-boot.js && node tools/test-editions.js && node tools/test-hotkeys.js",
    "fetch-voices": "node tools/fetch-voices.js"
  },
  "dependencies": {
    "node-simconnect": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.cockpit-efb.app",
    "productName": "Cockpit EFB",
    "asar": false,
    "files": [
      "boot.js",
      "code/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "efb-bundle",
        "to": "efb"
      },
      {
        "from": "piper-bundle",
        "to": "piper"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cockpit-EFB-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}